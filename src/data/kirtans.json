  {
    "id": "nrsimha-pranama",
    "title": "Nṛsiṁha Praṇāma",
    "composer": "Traditional",
    "source": "kksongs.org",
    "mode": "refrain-verse",
    "images": [],
    "content": [
      {
        "type": "refrain",
        "lines": [
          "namas te narasiṁhāya",
          "prahlādāhlāda-dāyine",
          "hiraṇyakaśipor vakṣaḥ-",
