          "keśava dhṛta-narahari-rūpa jaya jagadīśa hare"
        ]
      }
    ]
  },
  {
    "id": "bhaja-hunre-mana",
    "title": "Bhaja Hure Mana",
    "composer": "Narottama Dāsa Ṭhākura",
    "source": "kksongs.org",
    "mode": "refrain-verse",
    "images": [],
    "content": [
      {
        "type": "refrain",
        "lines": [
          "bhaja hure mana, śrī nanda-nandana",
          "abhaya-caraṇāravinda re",
          "durlabha mānava-janama sat-sange",
          "taroho e bhava-sindhu re"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "śīta ātapa, bāta bariṣaṇa",
          "e dina jāminī jāgi re",
          "biphale sevinu kṛpaṇa durajana",
          "capala sukha-laba lāgi' re"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "e dhana, yauvaṇa, putra, parijana",
          "ithe ki āche paratīti re",
          "kamala-dala-jala, jīvana ṭalamala",
          "bhajahu hari-pada nīti re"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "śravaṇa, kīrtana, smaraṇa, vandana",
          "pāda-sevana, dāsya re",
          "pūjana, sakhī-jana, ātma-nivedana",
          "narottama-dāsera āśā re"
        ]
      }
    ]
  },
  {
    "id": "nitai-pada-kamala",
    "title": "Nitāi-pada-kamala",
    "composer": "Narottama Dāsa Ṭhākura",
    "source": "kksongs.org",
    "mode": "refrain-verse",
    "images": [],
    "content": [
      {
        "type": "refrain",
        "lines": [
          "nitāi-pada-kamala, koṭī-candra-suśītala,",
          "je chāyāya jagat juḍāy",
          "heno nitāi bine bhāi, rādhā-kṛṣṇa pāite nāi,",
          "dṛḍha kori' dharo nitāir pāy"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "se sambandha nāhi jār, bṛthā janma gelo tār,",
          "sei paśu baḍo durācār",
          "nitāi nā bolilo mukhe, majilo saṁsāra-sukhe,",
          "vidyā-kule ki koribe tār"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "ahaṅkāre māttā hoiyā, nitāi-pada pāsariyā,",
          "asatyere satya kori māni",
          "nitāiyer koruṇā habe, braje rādhā-kṛṣṇa pābe,",
          "dharo nitāi-caraṇa du'khāni"
        ]
      },
      { "type": "gap" },
      {
        "type": "verse",
        "lines": [
          "nitāiyer caraṇa satya, tāṅhāra sevaka nitya,",
          "nitāi-pada sadā koro āśa",
          "narottama boro dukhī, nitāi more koro sukhī,",
          "rākho rāṅgā-caraṇera pāśa"
        ]
      }
    ]
  },
